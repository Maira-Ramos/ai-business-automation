# ==========================================
# AI Business Automation - .gitignore
# ==========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Python virtual environments
venv/
.venv/
env/
ENV/

# Environment variables
.env
.env.*

# Distribution / packaging
build/
dist/
downloads/
.eggs/
*.egg-info/
*.egg

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Type checking
.mypy_cache/
.pyre/
.pytype/

# Ruff
.ruff_cache/

# PyCharm
.idea/

# VS Code
.vscode/

# Jupyter
.ipynb_checkpoints/

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db
*~

# Runtime files
*.pid
*.seed

# Local databases
*.sqlite3
*.db

# Build artifacts
*.so
*.dylib
*.dll

# Temporary files
tmp/
temp/
